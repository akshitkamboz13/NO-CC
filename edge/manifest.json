{
    "manifest_version": 3,
    "name": "No CC: Hide YouTube™ Captions & Subtitles",
    "short_name": "No CC",
    "description": "Automatically turns off YouTube captions and subtitles. Lightweight extension to permanently hide CC and disable subtitles.",
    "version": "2.0.0",
    "homepage_url": "https://www.si4k.online/projects/no-cc",
    "icons": {
        "48": "icon-48.png",
        "128": "icon-128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon-48.png"
    },
    "permissions": [
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "*://*.youtube.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ]
}
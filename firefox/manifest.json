{
    "manifest_version": 2,
    "name": "No CC: Hide YouTube™ Captions & Subtitles",
    "short_name": "No CC",
    "description": "Automatically turns off YouTube captions and subtitles. Lightweight extension to permanently hide CC and disable subtitles.",
    "version": "1.3.0",
    "homepage_url": "https://www.si4k.online/projects/no-cc",
    "browser_specific_settings": {
        "gecko": {
            "id": "nocc@akshit.dev",
            "strict_min_version": "109.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "icons": {
        "48": "icon.svg",
        "128": "icon.svg"
    },
    "browser_action": {
        "default_popup": "popup.html",
        "default_icon": "icon.svg"
    },
    "permissions": [
        "storage",
        "*://*.youtube.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ]
}
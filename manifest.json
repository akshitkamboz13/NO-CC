{
    "manifest_version": 3,
    "name": "No CC: Hide YouTube™ Captions & Subtitles",
    "short_name": "No CC",
    "description": "Automatically turns off YouTube captions and subtitles. Lightweight extension to permanently hide CC and disable subtitles.",
    "version": "1.2.0",
    "icons": {
        "48": "icon.svg",
        "128": "icon.svg"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.svg"
    },
    "permissions": [
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "*://*.youtube.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "nocc@akshit.dev",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}